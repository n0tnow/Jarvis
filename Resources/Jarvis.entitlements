<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The ONE entitlement JARVIS.app needs under the hardened runtime: the microphone, which is opened only while Push-to-Talk is held (or when the opt-in wake mode is on).
	     Not sandboxed (see docs/APP_PACKAGING.md): no network-client, file-access, automation, camera, location or JIT entitlement is requested. verify.sh pins this list. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
